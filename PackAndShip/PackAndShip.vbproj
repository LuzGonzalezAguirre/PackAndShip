    </Compile>
    <Compile Update="PalletConfigurationForm.vb">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="PalletConfigurationForm.Designer.vb">
      <DependentUpon>PalletConfigurationForm.vb</DependentUpon>
    </Compile>
    <Compile Update="ScanRuleEditorForm.vb">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="ScanRuleEditorForm.Designer.vb">
