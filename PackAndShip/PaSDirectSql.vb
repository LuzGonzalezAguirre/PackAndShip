' AUTO-PORT of validated CCS procedure BODIES to parameterized SqlCommand.Text.
' No CREATE/ALTER/EXEC permissions are needed. Requires table-level CRUD permissions.
' Keep transaction, Q-Wall checks, uniqueness, approvals and audit triggers unchanged.
' Source of truth: sql/009,013,014,020,021,022. Do not hand-edit without schema review.
Public NotInheritable Class PaSDirectSql
    Private Sub New()
    End Sub

    Public Shared ReadOnly Property OpenContainer As String
        Get
            Return String.Join(vbCrLf, New String() {
                "BEGIN",
                "    SET NOCOUNT ON;",
                "    SET XACT_ABORT ON;",
                "",
                "    DECLARE @code VARCHAR(18) = LTRIM(RTRIM(ISNULL(@container_code, '')));",
                "    DECLARE @configuration_id INT, @prefix VARCHAR(5), @digits INT;",
                "    DECLARE @container_id INT, @expected_level_count INT, @expected_total INT;",
                "",
                "    BEGIN TRY",
                "        BEGIN TRANSACTION;",
                "",
                "        IF NOT EXISTS (",
                "            SELECT 1 FROM dbo.ssi_PaS_Users",
                "            WHERE user_id=@actor_user_id AND is_active=1",
                "        )",
                "            THROW 51001, 'An active PackAndShip user is required.', 1;",
                "",
                "        SELECT @prefix=pallet_prefix, @digits=pallet_digits",
                "        FROM dbo.ssi_PaS_GeneralSettings WITH (HOLDLOCK)",
                "        WHERE settings_id=1;",
                "",
                "        IF @prefix IS NULL OR @digits IS NULL",
                "            THROW 51002, 'Global pallet ID settings are missing.', 1;",
                "",
                "        IF @code COLLATE Latin1_General_BIN2 NOT LIKE",
                "            (@prefix + REPLICATE('[0-9]', @digits)) COLLATE Latin1_General_BIN2",
                "            OR LEN(@code) <> LEN(@prefix) + @digits",
                "            THROW 51003, 'Container code does not match General Settings.', 1;",
                "",
                "        SELECT @configuration_id=configuration_id,",
                "               @expected_total=total_pieces",
                "        FROM dbo.ssi_PaS_PalletConfigurations WITH (UPDLOCK, HOLDLOCK)",
                "        WHERE pn_id=@pn_id AND is_active=1;",
                "",
                "        IF @configuration_id IS NULL",
                "            THROW 51004, 'Active pallet configuration not found for this part.', 1;",
                "",
                "        SELECT @expected_level_count=COUNT(*)",
                "        FROM dbo.ssi_PaS_PalletLevels",
                "        WHERE configuration_id=@configuration_id;",
                "",
                "        IF @expected_level_count = 0",
                "           OR (SELECT COALESCE(SUM(required_pieces), 0)",
                "               FROM dbo.ssi_PaS_PalletLevels",
                "               WHERE configuration_id=@configuration_id) <> @expected_total",
                "           OR (SELECT MAX(level_number) FROM dbo.ssi_PaS_PalletLevels",
                "               WHERE configuration_id=@configuration_id) <> @expected_level_count",
                "            THROW 51005, 'Pallet configuration levels are missing or inconsistent.', 1;",
                "",
                "        -- Container codes are never reusable, including after CANCELLED.",
                "        IF EXISTS (",
                "            SELECT 1 FROM dbo.ssi_PaS_Containers WITH (UPDLOCK, HOLDLOCK)",
                "            WHERE container_code=@code",
                "        )",
                "            THROW 51006, 'This container code is already registered.', 1;",
                "",
                "        INSERT INTO dbo.ssi_PaS_Containers",
                "            (container_code, configuration_id, status, created_by_user_id)",
                "        VALUES (@code, @configuration_id, 'OPEN', @actor_user_id);",
                "        SET @container_id=CONVERT(INT, SCOPE_IDENTITY());",
                "",
                "        INSERT INTO dbo.ssi_PaS_ContainerLevels",
                "            (container_id, level_number, required_pieces)",
                "        SELECT @container_id, level_number, required_pieces",
                "        FROM dbo.ssi_PaS_PalletLevels",
                "        WHERE configuration_id=@configuration_id;",
                "",
                "        IF @@ROWCOUNT <> @expected_level_count",
                "            THROW 51007, 'Could not snapshot all configured pallet levels.', 1;",
                "",
                "        COMMIT TRANSACTION;",
                "",
                "        SELECT @container_id AS container_id, @code AS container_code,",
                "               @pn_id AS pn_id, @expected_level_count AS level_count,",
                "               @expected_total AS required_total, 'OPEN' AS status;",
                "    END TRY",
                "    BEGIN CATCH",
                "        IF @@TRANCOUNT > 0 ROLLBACK TRANSACTION;",
                "        THROW;",
                "    END CATCH;",
                "END;"
            })
        End Get
    End Property

    Public Shared ReadOnly Property CloseLevel As String
        Get
            Return String.Join(vbCrLf, New String() {
                "BEGIN",
                "    SET NOCOUNT ON;",
                "    SET XACT_ABORT ON;",
                "    DECLARE @level_id INT, @required INT, @actual INT;",
                "",
                "    BEGIN TRY",
                "        BEGIN TRANSACTION;",
                "",
                "        IF NOT EXISTS (",
                "            SELECT 1 FROM dbo.ssi_PaS_Users",
                "            WHERE user_id=@actor_user_id AND is_active=1",
                "        )",
                "            THROW 51201, 'An active PackAndShip user is required.', 1;",
                "",
                "        IF NOT EXISTS (",
                "            SELECT 1 FROM dbo.ssi_PaS_Containers WITH (UPDLOCK, HOLDLOCK)",
                "            WHERE container_id=@container_id AND status='OPEN'",
                "        )",
                "            THROW 51202, 'Container must be OPEN.', 1;",
                "",
                "        SELECT @level_id=container_level_id, @required=required_pieces",
                "        FROM dbo.ssi_PaS_ContainerLevels WITH (UPDLOCK, HOLDLOCK)",
                "        WHERE container_id=@container_id AND level_number=@level_number",
                "              AND status='OPEN';",
                "",
                "        IF @level_id IS NULL",
                "            THROW 51203, 'Level is missing or already closed.', 1;",
                "",
                "        SELECT @actual=COUNT(*)",
                "        FROM dbo.ssi_PaS_ContainerPieces",
                "        WHERE container_level_id=@level_id;",
                "",
                "        IF @actual <> @required",
                "            THROW 51204, 'Level cannot close before the exact required quantity.', 1;",
                "",
                "        UPDATE dbo.ssi_PaS_ContainerLevels",
                "        SET status='CLOSED', closed_at=SYSUTCDATETIME(),",
                "            closed_by_user_id=@actor_user_id",
                "        WHERE container_level_id=@level_id AND status='OPEN';",
                "",
                "        IF @@ROWCOUNT<>1",
                "            THROW 51205, 'Level status changed during closure.', 1;",
                "",
                "        COMMIT TRANSACTION;",
                "        SELECT @container_id AS container_id, @level_number AS level_number,",
                "               'CLOSED' AS status, @actual AS scanned_pieces;",
                "    END TRY",
                "    BEGIN CATCH",
                "        IF @@TRANCOUNT>0 ROLLBACK TRANSACTION;",
                "        THROW;",
                "    END CATCH;",
                "END;"
            })
        End Get
    End Property

    Public Shared ReadOnly Property CloseContainer As String
        Get
            Return String.Join(vbCrLf, New String() {
                "BEGIN",
                "    SET NOCOUNT ON;",
                "    SET XACT_ABORT ON;",
                "    DECLARE @levels INT, @total_required INT, @total_actual INT;",
                "",
                "    BEGIN TRY",
                "        BEGIN TRANSACTION;",
                "",
                "        IF NOT EXISTS (",
                "            SELECT 1 FROM dbo.ssi_PaS_Users",
                "            WHERE user_id=@actor_user_id AND is_active=1",
                "        )",
                "            THROW 51301, 'An active PackAndShip user is required.', 1;",
                "",
                "        IF NOT EXISTS (",
                "            SELECT 1 FROM dbo.ssi_PaS_Containers WITH (UPDLOCK, HOLDLOCK)",
                "            WHERE container_id=@container_id AND status='OPEN'",
                "        )",
                "            THROW 51302, 'Container is missing or not OPEN.', 1;",
                "",
                "        -- Aggregate verifies each level, rather than only the overall total.",
                "        IF EXISTS (",
                "            SELECT 1 FROM dbo.ssi_PaS_ContainerLevels AS l",
                "            OUTER APPLY (",
                "                SELECT COUNT(*) AS actual",
                "                FROM dbo.ssi_PaS_ContainerPieces AS p",
                "                WHERE p.container_level_id=l.container_level_id",
                "            ) AS counted",
                "            WHERE l.container_id=@container_id",
                "              AND (l.status<>'CLOSED' OR counted.actual<>l.required_pieces)",
                "        )",
                "            THROW 51303, 'All levels must be CLOSED and contain their exact required pieces.', 1;",
                "",
                "        SELECT @levels=COUNT(*), @total_required=SUM(required_pieces)",
                "        FROM dbo.ssi_PaS_ContainerLevels",
                "        WHERE container_id=@container_id;",
                "",
                "        IF @levels IS NULL OR @levels=0",
                "            THROW 51304, 'Container has no levels.', 1;",
                "",
                "        SELECT @total_actual=COUNT(*)",
                "        FROM dbo.ssi_PaS_ContainerPieces AS p",
                "        JOIN dbo.ssi_PaS_ContainerLevels AS l",
                "            ON l.container_level_id=p.container_level_id",
                "        WHERE l.container_id=@container_id;",
                "",
                "        IF @total_actual<>@total_required",
                "            THROW 51305, 'Container piece total does not match its required total.', 1;",
                "",
                "        UPDATE dbo.ssi_PaS_Containers",
                "        SET status='CLOSED', closed_at=SYSUTCDATETIME(),",
                "            closed_by_user_id=@actor_user_id",
                "        WHERE container_id=@container_id AND status='OPEN';",
                "",
                "        IF @@ROWCOUNT<>1",
                "            THROW 51306, 'Container status changed during closure.', 1;",
                "",
                "        COMMIT TRANSACTION;",
                "",
                "        SELECT @container_id AS container_id, 'CLOSED' AS status,",
                "               @levels AS closed_levels, @total_actual AS scanned_pieces;",
                "    END TRY",
                "    BEGIN CATCH",
                "        IF @@TRANCOUNT>0 ROLLBACK TRANSACTION;",
                "        THROW;",
                "    END CATCH;",
                "END;"
            })
        End Get
    End Property

    Public Shared ReadOnly Property AddPiece As String
        Get
            Return String.Join(vbCrLf, New String() {
                "BEGIN",
                "    SET NOCOUNT ON;",
                "    SET XACT_ABORT ON;",
                "",
                "    DECLARE @container_level_id INT, @required INT, @count INT;",
                "    DECLARE @pn_id INT, @product_id INT, @inspection_id INT;",
                "    DECLARE @inspection_result BIT, @is_scrap BIT, @finished_at DATETIME2;",
                "    DECLARE @ssi NVARCHAR(200) = LTRIM(RTRIM(ISNULL(@ssi_full_code, N'')));",
                "    DECLARE @client NVARCHAR(200) = LTRIM(RTRIM(ISNULL(@client_full_code, N'')));",
                "",
                "    BEGIN TRY",
                "        BEGIN TRANSACTION;",
                "",
                "        IF NOT EXISTS (",
                "            SELECT 1 FROM dbo.ssi_PaS_Users",
                "            WHERE user_id=@actor_user_id AND is_active=1",
                "        )",
                "            THROW 51101, 'An active PackAndShip user is required.', 1;",
                "",
                "        IF @ssi=N'' OR @client=N''",
                "            THROW 51102, 'Both full SSI and Client codes are required.', 1;",
                "",
                "        -- Serialize writes per container, including level close and pallet close.",
                "        SELECT @pn_id=cfg.pn_id",
                "        FROM dbo.ssi_PaS_Containers AS c WITH (UPDLOCK, HOLDLOCK)",
                "        INNER JOIN dbo.ssi_PaS_PalletConfigurations AS cfg",
                "            ON cfg.configuration_id=c.configuration_id",
                "        WHERE c.container_id=@container_id AND c.status='OPEN';",
                "",
                "        IF @pn_id IS NULL",
                "            THROW 51103, 'Container is missing or not OPEN.', 1;",
                "",
                "        SELECT @container_level_id=container_level_id,",
                "               @required=required_pieces",
                "        FROM dbo.ssi_PaS_ContainerLevels WITH (UPDLOCK, HOLDLOCK)",
                "        WHERE container_id=@container_id AND level_number=@level_number",
                "              AND status='OPEN';",
                "",
                "        IF @container_level_id IS NULL",
                "            THROW 51104, 'Level is missing or not OPEN.', 1;",
                "",
                "        SELECT @count=COUNT(*)",
                "        FROM dbo.ssi_PaS_ContainerPieces WITH (UPDLOCK, HOLDLOCK)",
                "        WHERE container_level_id=@container_level_id;",
                "",
                "        IF @count >= @required",
                "            THROW 51105, 'Level is already at its required piece quantity.', 1;",
                "",
                "        -- Require exactly one Q-Wall product for the selected part and full QR codes.",
                "        IF (SELECT COUNT(*)",
                "            FROM dbo.ssi_Products",
                "            WHERE pn_id=@pn_id AND frameSN=@ssi AND fpcaSN=@client) <> 1",
                "            THROW 51106, 'Q-Wall product identity is missing or ambiguous.', 1;",
                "",
                "        SELECT @product_id=product_id",
                "        FROM dbo.ssi_Products",
                "        WHERE pn_id=@pn_id AND frameSN=@ssi AND fpcaSN=@client;",
                "",
                "        -- Unique index also guarantees this across multiple stations.",
                "        IF EXISTS (",
                "            SELECT 1 FROM dbo.ssi_PaS_ContainerPieces WITH (UPDLOCK, HOLDLOCK)",
                "            WHERE product_id=@product_id",
                "        )",
                "            THROW 51107, 'Piece already belongs to a container.', 1;",
                "",
                "        -- Only the most recent completed-or-started Q-Wall inspection is authoritative.",
                "        SELECT TOP (1)",
                "            @inspection_id=inspection_id,",
                "            @inspection_result=overall_result,",
                "            @is_scrap=is_scrap,",
                "            @finished_at=finished_at",
                "        FROM dbo.ssi_Inspections WITH (HOLDLOCK)",
                "        WHERE product_id=@product_id",
                "        ORDER BY COALESCE(finished_at,started_at) DESC, inspection_id DESC;",
                "",
                "        IF @inspection_id IS NULL OR @finished_at IS NULL",
                "           OR ISNULL(@inspection_result,0)<>1 OR ISNULL(@is_scrap,0)<>0",
                "            THROW 51108, 'Latest Q-Wall inspection is not finished PASS.', 1;",
                "",
                "        -- Confirmed Q-Wall policy: a flag is released when its record",
                "        -- contains authorized_by_user_id and authorized_at. Authorization",
                "        -- is stored on the flag, not necessarily on ssi_Inspections.",
                "        -- Past inspection flags do not automatically block a newer PASS.",
                "        -- Every flag belonging to the latest inspection must be authorized",
                "        -- and tied to this same Q-Wall product.",
                "        IF EXISTS (",
                "            SELECT 1 FROM dbo.ssi_PieceFlagRecords WITH (HOLDLOCK)",
                "            WHERE inspection_id=@inspection_id",
                "              AND (product_id<>@product_id",
                "                   OR authorized_by_user_id IS NULL",
                "                   OR authorized_at IS NULL)",
                "        )",
                "            THROW 51109, 'Latest Q-Wall inspection has a Quality flag without valid authorization.', 1;",
                "",
                "        INSERT INTO dbo.ssi_PaS_ContainerPieces",
                "            (container_level_id, product_id, verified_inspection_id, scanned_by_user_id)",
                "        VALUES (@container_level_id, @product_id, @inspection_id, @actor_user_id);",
                "",
                "        SET @count=@count+1;",
                "        COMMIT TRANSACTION;",
                "",
                "        SELECT @product_id AS product_id, @inspection_id AS inspection_id,",
                "               @container_id AS container_id, @level_number AS level_number,",
                "               @count AS scanned_pieces, @required AS required_pieces;",
                "    END TRY",
                "    BEGIN CATCH",
                "        IF @@TRANCOUNT > 0 ROLLBACK TRANSACTION;",
                "        THROW;",
                "    END CATCH;",
                "END;"
            })
        End Get
    End Property

    Public Shared ReadOnly Property ApproveScanRejection As String
        Get
            Return String.Join(vbCrLf, New String() {
                "BEGIN",
                "    SET NOCOUNT ON;",
                "    SET XACT_ABORT ON;",
                "    DECLARE @user_id INT, @role_id INT, @detector INT;",
                "    BEGIN TRY",
                "        BEGIN TRANSACTION;",
                "        SELECT @detector=detected_by_user_id",
                "        FROM dbo.ssi_PaS_ScanRejections WITH(UPDLOCK,HOLDLOCK)",
                "        WHERE rejection_id=@rejection_id AND status='BLOCKED';",
                "        IF @detector IS NULL THROW 52011,'El rechazo no esta pendiente.',1;",
                "        IF NOT EXISTS (SELECT 1 FROM dbo.ssi_PaS_RejectionRequirements",
                "                       WHERE rejection_id=@rejection_id AND department_id=@department_id)",
                "            THROW 52012,'El departamento no es requerido para este rechazo.',1;",
                "        SELECT @user_id=user_id,@role_id=role_id",
                "        FROM dbo.ssi_PaS_Users",
                "        WHERE barcode_id=UPPER(LTRIM(RTRIM(@barcode))) AND is_active=1",
                "          AND password_hash=HASHBYTES('SHA2_256',CONVERT(VARCHAR(50),@password));",
                "        IF @user_id IS NULL THROW 52013,'Credenciales incorrectas o usuario inactivo.',1;",
                "        IF @user_id=@detector THROW 52014,'El operador del rechazo no puede autorizarse a si mismo.',1;",
                "        IF NOT EXISTS (SELECT 1 FROM dbo.ssi_PaS_RejectionDepartmentRoles",
                "                       WHERE department_id=@department_id AND role_id=@role_id)",
                "            THROW 52015,'El rol del usuario no esta autorizado para este departamento.',1;",
                "        IF EXISTS (SELECT 1 FROM dbo.ssi_PaS_RejectionApprovals",
                "                   WHERE rejection_id=@rejection_id AND authorized_by_user_id=@user_id)",
                "            THROW 52016,'Una persona solo puede aprobar un departamento por rechazo.',1;",
                "        IF EXISTS (SELECT 1 FROM dbo.ssi_PaS_RejectionApprovals",
                "                   WHERE rejection_id=@rejection_id AND department_id=@department_id)",
                "            THROW 52017,'Este departamento ya aprobo el rechazo.',1;",
                "        INSERT dbo.ssi_PaS_RejectionApprovals(rejection_id,department_id,authorized_by_user_id)",
                "        VALUES (@rejection_id,@department_id,@user_id);",
                "        IF NOT EXISTS (",
                "            SELECT 1 FROM dbo.ssi_PaS_RejectionRequirements rr",
                "            WHERE rr.rejection_id=@rejection_id AND NOT EXISTS (",
                "                SELECT 1 FROM dbo.ssi_PaS_RejectionApprovals a",
                "                WHERE a.rejection_id=rr.rejection_id AND a.department_id=rr.department_id)",
                "        ) AND EXISTS (SELECT 1 FROM dbo.ssi_PaS_RejectionRequirements WHERE rejection_id=@rejection_id)",
                "            UPDATE dbo.ssi_PaS_ScanRejections SET status='APPROVED',resolved_at=SYSUTCDATETIME()",
                "            WHERE rejection_id=@rejection_id AND status='BLOCKED';",
                "        COMMIT TRANSACTION;",
                "        SELECT status FROM dbo.ssi_PaS_ScanRejections WHERE rejection_id=@rejection_id;",
                "    END TRY",
                "    BEGIN CATCH",
                "        IF @@TRANCOUNT>0 ROLLBACK TRANSACTION;",
                "        THROW;",
                "    END CATCH",
                "END;"
            })
        End Get
    End Property

    Public Shared ReadOnly Property SaveRejectionDepartment As String
        Get
            Return String.Join(vbCrLf, New String() {
                "BEGIN",
                "    SET NOCOUNT ON;",
                "    SET XACT_ABORT ON;",
                "    BEGIN TRY",
                "        BEGIN TRANSACTION;",
                "        IF NOT EXISTS(",
                "            SELECT 1 FROM dbo.ssi_PaS_Users u",
                "            JOIN dbo.ssi_PaS_Roles r ON r.role_id=u.role_id",
                "            WHERE u.user_id=@actor_user_id AND u.is_active=1 AND r.can_modify_setup=1",
                "        ) THROW 52021,'No tienes permiso para configurar autorizaciones.',1;",
                "        IF NOT EXISTS (SELECT 1 FROM dbo.ssi_PaS_RejectionDepartments WHERE department_id=@department_id)",
                "            THROW 52022,'Departamento inexistente.',1;",
                "        DECLARE @roles TABLE(role_id INT PRIMARY KEY);",
                "        INSERT @roles(role_id)",
                "        SELECT DISTINCT TRY_CONVERT(INT,LTRIM(RTRIM(value)))",
                "        FROM STRING_SPLIT(@roles_csv,',')",
                "        WHERE TRY_CONVERT(INT,LTRIM(RTRIM(value))) IS NOT NULL;",
                "        IF EXISTS(SELECT 1 FROM @roles a WHERE NOT EXISTS (",
                "            SELECT 1 FROM dbo.ssi_PaS_Roles r WHERE r.role_id=a.role_id))",
                "            THROW 52023,'Uno de los roles seleccionados no existe.',1;",
                "        IF @is_required=1 AND NOT EXISTS(SELECT 1 FROM @roles)",
                "            THROW 52024,'Un departamento habilitado requiere al menos un rol.',1;",
                "        IF @is_required=0 AND NOT EXISTS (",
                "            SELECT 1 FROM dbo.ssi_PaS_RejectionDepartments",
                "            WHERE department_id<>@department_id AND is_required=1",
                "        ) THROW 52025,'Debe mantenerse habilitado al menos un departamento.',1;",
                "        UPDATE dbo.ssi_PaS_RejectionDepartments",
                "        SET is_required=@is_required WHERE department_id=@department_id;",
                "        DELETE dbo.ssi_PaS_RejectionDepartmentRoles WHERE department_id=@department_id;",
                "        INSERT dbo.ssi_PaS_RejectionDepartmentRoles(department_id,role_id)",
                "        SELECT @department_id,role_id FROM @roles;",
                "        COMMIT TRANSACTION;",
                "    END TRY",
                "    BEGIN CATCH",
                "        IF @@TRANCOUNT>0 ROLLBACK TRANSACTION;",
                "        THROW;",
                "    END CATCH",
                "END;"
            })
        End Get
    End Property

    Public Shared ReadOnly Property StartScanRejection As String
        Get
            Return String.Join(vbCrLf, New String() {
                "BEGIN",
                "    SET NOCOUNT ON;",
                "    SET XACT_ABORT ON;",
                "    DECLARE @id BIGINT;",
                "    SET @event_token=COALESCE(@event_token,NEWID());",
                "",
                "    BEGIN TRY",
                "        BEGIN TRANSACTION;",
                "",
                "        -- El bloqueo del contenedor serializa altas concurrentes.",
                "        IF NOT EXISTS (",
                "            SELECT 1 FROM dbo.ssi_PaS_Containers WITH (UPDLOCK,HOLDLOCK)",
                "            WHERE container_id=@container_id AND status='OPEN'",
                "        ) THROW 52101,'Solo se registran rechazos en pallets abiertos.',1;",
                "",
                "        IF NOT EXISTS (",
                "            SELECT 1 FROM dbo.ssi_PaS_Users",
                "            WHERE user_id=@actor_user_id AND is_active=1",
                "        ) THROW 52102,'Se requiere un usuario activo.',1;",
                "",
                "        -- Si la misma estación reintenta un evento ya confirmado en CCS,",
                "        -- recuperar su rechazo original, sin generar una fila nueva.",
                "        SELECT @id=rejection_id",
                "        FROM dbo.ssi_PaS_ScanRejectionEvents WITH(UPDLOCK,HOLDLOCK)",
                "        WHERE event_token=@event_token;",
                "",
                "        IF @id IS NULL",
                "        BEGIN",
                "            SELECT @id=rejection_id",
                "            FROM dbo.ssi_PaS_ScanRejections WITH(UPDLOCK,HOLDLOCK)",
                "            WHERE container_id=@container_id AND status='BLOCKED';",
                "",
                "            IF @id IS NULL",
                "            BEGIN",
                "                INSERT dbo.ssi_PaS_ScanRejections",
                "                    (container_id,rejection_type,ssi_scan,client_scan,",
                "                     rejection_reason,detected_by_user_id)",
                "                VALUES",
                "                    (@container_id,@rejection_type,COALESCE(@ssi_scan,N''),",
                "                     @client_scan,LEFT(COALESCE(@reason,N''),1000),@actor_user_id);",
                "",
                "                SET @id=SCOPE_IDENTITY();",
                "",
                "                INSERT dbo.ssi_PaS_RejectionRequirements(rejection_id,department_id)",
                "                SELECT @id,department_id",
                "                FROM dbo.ssi_PaS_RejectionDepartments WHERE is_required=1;",
                "            END;",
                "",
                "            -- Registrar CADA incidencia detectada, aunque el contenedor",
                "            -- ya estuviera bloqueado por un rechazo anterior.",
                "            INSERT dbo.ssi_PaS_ScanRejectionEvents",
                "                (event_token,rejection_id,container_id,rejection_type,",
                "                 ssi_scan,client_scan,rejection_reason,detected_by_user_id)",
                "            VALUES",
                "                (@event_token,@id,@container_id,@rejection_type,",
                "                 COALESCE(@ssi_scan,N''),@client_scan,",
                "                 LEFT(COALESCE(@reason,N''),1000),@actor_user_id);",
                "        END;",
                "",
                "        COMMIT TRANSACTION;",
                "        SELECT @id AS rejection_id,@event_token AS event_token;",
                "    END TRY",
                "    BEGIN CATCH",
                "        IF @@TRANCOUNT>0 ROLLBACK TRANSACTION;",
                "        THROW;",
                "    END CATCH",
                "END;"
            })
        End Get
    End Property

    Public Shared ReadOnly Property BeginPalletAction As String
        Get
            Return String.Join(vbCrLf, New String() {
                "BEGIN",
                "    SET NOCOUNT ON; SET XACT_ABORT ON;",
                "    DECLARE @id BIGINT;",
                "    DECLARE @note NVARCHAR(500)=LTRIM(RTRIM(COALESCE(@reason,N'')));",
                "    BEGIN TRY",
                "        BEGIN TRANSACTION;",
                "        IF @action_type NOT IN('CLOSE_PARTIAL','CANCEL_EMPTY')",
                "            THROW 52201,'Tipo de operación no permitido.',1;",
                "        IF LEN(@note)<10 THROW 52202,'Motivo obligatorio: mínimo 10 caracteres.',1;",
                "        IF NOT EXISTS(SELECT 1 FROM dbo.ssi_PaS_Users",
                "                      WHERE user_id=@packing_user_id AND is_active=1)",
                "            THROW 52203,'El operador no tiene una sesión activa.',1;",
                "        IF NOT EXISTS(SELECT 1 FROM dbo.ssi_PaS_Containers WITH(UPDLOCK,HOLDLOCK)",
                "                      WHERE container_id=@container_id AND status='OPEN')",
                "            THROW 52204,'El pallet debe estar ABIERTO.',1;",
                "        IF EXISTS(SELECT 1 FROM dbo.ssi_PaS_ScanRejections",
                "                  WHERE container_id=@container_id AND status='BLOCKED')",
                "            THROW 52205,'Resuelve primero el rechazo de pieza pendiente.',1;",
                "        SELECT @id=request_id FROM dbo.ssi_PaS_PalletActionRequests WITH(UPDLOCK,HOLDLOCK)",
                "        WHERE container_id=@container_id AND status='PENDING';",
                "        IF @id IS NOT NULL",
                "        BEGIN",
                "            IF NOT EXISTS(SELECT 1 FROM dbo.ssi_PaS_PalletActionRequests",
                "                WHERE request_id=@id AND action_type=@action_type",
                "                  AND requested_by_user_id=@packing_user_id AND reason=@note)",
                "                THROW 52206,'Ya existe una solicitud diferente pendiente en este pallet.',1;",
                "        END",
                "        ELSE",
                "        BEGIN",
                "            IF NOT EXISTS(SELECT 1 FROM dbo.ssi_PaS_RejectionDepartments WHERE is_required=1)",
                "                THROW 52207,'Habilita al menos un departamento autorizador en Setup.',1;",
                "            IF EXISTS(",
                "                SELECT 1 FROM dbo.ssi_PaS_RejectionDepartments d",
                "                WHERE d.is_required=1 AND NOT EXISTS(",
                "                    SELECT 1 FROM dbo.ssi_PaS_RejectionDepartmentRoles m",
                "                    WHERE m.department_id=d.department_id",
                "                )",
                "            ) THROW 52208,'Hay un departamento sin roles autorizados.',1;",
                "            INSERT dbo.ssi_PaS_PalletActionRequests",
                "                (container_id,action_type,requested_by_user_id,reason)",
                "            VALUES(@container_id,@action_type,@packing_user_id,@note);",
                "            SET @id=SCOPE_IDENTITY();",
                "            INSERT dbo.ssi_PaS_PalletActionRequirements(request_id,department_id)",
                "            SELECT @id,department_id FROM dbo.ssi_PaS_RejectionDepartments WHERE is_required=1;",
                "        END;",
                "        COMMIT TRANSACTION;",
                "        SELECT @id AS request_id;",
                "    END TRY",
                "    BEGIN CATCH",
                "        IF @@TRANCOUNT>0 ROLLBACK TRANSACTION;",
                "        THROW;",
                "    END CATCH",
                "END;"
            })
        End Get
    End Property

    Public Shared ReadOnly Property ApprovePalletAction As String
        Get
            Return String.Join(vbCrLf, New String() {
                "BEGIN",
                "    SET NOCOUNT ON; SET XACT_ABORT ON;",
                "    DECLARE @user_id INT,@role_id INT,@operator INT;",
                "    BEGIN TRY",
                "        BEGIN TRANSACTION;",
                "        SELECT @operator=requested_by_user_id",
                "        FROM dbo.ssi_PaS_PalletActionRequests WITH(UPDLOCK,HOLDLOCK)",
                "        WHERE request_id=@request_id AND status='PENDING';",
                "        IF @operator IS NULL THROW 52211,'La solicitud ya no está pendiente.',1;",
                "        IF NOT EXISTS(SELECT 1 FROM dbo.ssi_PaS_PalletActionRequirements",
                "                      WHERE request_id=@request_id AND department_id=@department_id)",
                "            THROW 52212,'Este departamento no requiere aprobación.',1;",
                "        SELECT @user_id=user_id,@role_id=role_id",
                "        FROM dbo.ssi_PaS_Users",
                "        WHERE barcode_id=UPPER(LTRIM(RTRIM(@barcode))) AND is_active=1",
                "          AND password_hash=HASHBYTES('SHA2_256',CONVERT(VARCHAR(50),@password));",
                "        IF @user_id IS NULL THROW 52213,'Credenciales incorrectas o usuario inactivo.',1;",
                "        IF @user_id=@operator THROW 52214,'El operador solicitante no puede aprobar su propio pallet.',1;",
                "        IF NOT EXISTS(SELECT 1 FROM dbo.ssi_PaS_RejectionDepartmentRoles",
                "                      WHERE department_id=@department_id AND role_id=@role_id)",
                "            THROW 52215,'El rol no está autorizado para ese departamento.',1;",
                "        IF EXISTS(SELECT 1 FROM dbo.ssi_PaS_PalletActionApprovals",
                "                  WHERE request_id=@request_id AND authorized_by_user_id=@user_id)",
                "            THROW 52216,'Un usuario solo puede aprobar un departamento.',1;",
                "        INSERT dbo.ssi_PaS_PalletActionApprovals",
                "            (request_id,department_id,authorized_by_user_id)",
                "        VALUES(@request_id,@department_id,@user_id);",
                "        COMMIT TRANSACTION;",
                "    END TRY",
                "    BEGIN CATCH",
                "        IF @@TRANCOUNT>0 ROLLBACK TRANSACTION;",
                "        THROW;",
                "    END CATCH",
                "END;"
            })
        End Get
    End Property

    Public Shared ReadOnly Property CompletePalletAction As String
        Get
            Return String.Join(vbCrLf, New String() {
                "BEGIN",
                "    SET NOCOUNT ON; SET XACT_ABORT ON;",
                "    DECLARE @container INT,@action VARCHAR(20),@note NVARCHAR(500);",
                "    DECLARE @actual INT,@required INT,@authorizer INT;",
                "    BEGIN TRY",
                "        BEGIN TRANSACTION;",
                "        SELECT @container=container_id,@action=action_type,@note=reason",
                "        FROM dbo.ssi_PaS_PalletActionRequests WITH(UPDLOCK,HOLDLOCK)",
                "        WHERE request_id=@request_id AND status='PENDING'",
                "          AND requested_by_user_id=@packing_user_id;",
                "        IF @container IS NULL THROW 52221,'Solicitud inexistente, completada o de otro usuario.',1;",
                "        IF NOT EXISTS(SELECT 1 FROM dbo.ssi_PaS_Users",
                "                      WHERE user_id=@packing_user_id AND is_active=1)",
                "            THROW 52222,'Operador inactivo.',1;",
                "        IF NOT EXISTS(SELECT 1 FROM dbo.ssi_PaS_Containers WITH(UPDLOCK,HOLDLOCK)",
                "                      WHERE container_id=@container AND status='OPEN')",
                "            THROW 52223,'Pallet cerrado o modificado.',1;",
                "        IF EXISTS(SELECT 1 FROM dbo.ssi_PaS_ScanRejections",
                "                  WHERE container_id=@container AND status='BLOCKED')",
                "            THROW 52224,'Hay una pieza rechazada pendiente de aprobación.',1;",
                "        IF NOT EXISTS(SELECT 1 FROM dbo.ssi_PaS_PalletActionRequirements",
                "                      WHERE request_id=@request_id)",
                "            THROW 52225,'Solicitud sin departamentos requeridos.',1;",
                "        IF EXISTS(",
                "            SELECT 1 FROM dbo.ssi_PaS_PalletActionRequirements req",
                "            WHERE req.request_id=@request_id AND NOT EXISTS(",
                "                SELECT 1 FROM dbo.ssi_PaS_PalletActionApprovals a",
                "                WHERE a.request_id=req.request_id AND a.department_id=req.department_id",
                "            )",
                "        ) THROW 52226,'Faltan aprobaciones de departamentos.',1;",
                "        -- El primer autorizador representa el registro legado; todas las aprobaciones",
                "        -- quedan guardadas individualmente en ssi_PaS_PalletActionApprovals.",
                "        SELECT TOP(1) @authorizer=authorized_by_user_id",
                "        FROM dbo.ssi_PaS_PalletActionApprovals",
                "        WHERE request_id=@request_id ORDER BY department_id;",
                "        IF @authorizer IS NULL THROW 52227,'No hay aprobadores.',1;",
                "        SELECT @required=SUM(required_pieces)",
                "        FROM dbo.ssi_PaS_ContainerLevels WITH(UPDLOCK,HOLDLOCK)",
                "        WHERE container_id=@container;",
                "        SELECT @actual=COUNT(*)",
                "        FROM dbo.ssi_PaS_ContainerPieces p WITH(UPDLOCK,HOLDLOCK)",
                "        JOIN dbo.ssi_PaS_ContainerLevels l WITH(UPDLOCK,HOLDLOCK)",
                "            ON l.container_level_id=p.container_level_id",
                "        WHERE l.container_id=@container;",
                "        IF @action='CLOSE_PARTIAL'",
                "        BEGIN",
                "            IF @actual<=0 OR @actual>=@required OR @required IS NULL",
                "                THROW 52228,'El pallet parcial debe tener piezas y estar incompleto.',1;",
                "            UPDATE dbo.ssi_PaS_Containers",
                "            SET status='PARTIAL',closed_at=SYSUTCDATETIME(),closed_by_user_id=@authorizer",
                "            WHERE container_id=@container AND status='OPEN';",
                "            INSERT dbo.ssi_PaS_PartialClosures",
                "                (container_id,authorized_by_user_id,packing_user_id,",
                "                 actual_pieces,required_pieces,reason)",
                "            VALUES (@container,@authorizer,@packing_user_id,@actual,@required,@note);",
                "            INSERT dbo.ssi_PaS_PackingAudit",
                "                (event_type,container_id,actor_user_id,reason)",
                "            VALUES ('CLOSE_PARTIAL',@container,@authorizer,@note);",
                "        END",
                "        ELSE IF @action='CANCEL_EMPTY'",
                "        BEGIN",
                "            IF @actual<>0 OR EXISTS(SELECT 1 FROM dbo.ssi_PaS_ContainerLevels",
                "                                    WHERE container_id=@container AND status='CLOSED')",
                "                THROW 52229,'Solo se cancela un pallet vacío, sin niveles cerrados.',1;",
                "            UPDATE dbo.ssi_PaS_Containers SET status='CANCELLED'",
                "            WHERE container_id=@container AND status='OPEN';",
                "            INSERT dbo.ssi_PaS_EmptyPalletCancellations",
                "                (container_id,packing_user_id,authorized_by_user_id,reason)",
                "            VALUES (@container,@packing_user_id,@authorizer,@note);",
                "            INSERT dbo.ssi_PaS_PackingAudit",
                "                (event_type,container_id,actor_user_id,reason)",
                "            VALUES ('CANCEL_CONTAINER',@container,@authorizer,@note);",
                "        END",
                "        ELSE THROW 52230,'Tipo de operación no reconocido.',1;",
                "        UPDATE dbo.ssi_PaS_PalletActionRequests",
                "        SET status='COMPLETED',completed_at=SYSUTCDATETIME()",
                "        WHERE request_id=@request_id;",
                "        COMMIT TRANSACTION;",
                "        SELECT @container AS container_id,@action AS action_type,'COMPLETED' AS status;",
                "    END TRY",
                "    BEGIN CATCH",
                "        IF @@TRANCOUNT>0 ROLLBACK TRANSACTION;",
                "        THROW;",
                "    END CATCH",
                "END;"
            })
        End Get
    End Property

    Public Shared ReadOnly Property RemovePiece As String
        Get
            Return String.Join(vbCrLf, New String() {
                "BEGIN",
                "    SET NOCOUNT ON;",
                "    SET XACT_ABORT ON;",
                "    DECLARE @piece_id BIGINT, @level_id INT, @inspection_id INT;",
                "    DECLARE @note NVARCHAR(500)=LTRIM(RTRIM(ISNULL(@reason,N'')));",
                "    BEGIN TRY",
                "        BEGIN TRANSACTION;",
                "        IF NOT EXISTS (",
                "            SELECT 1 FROM dbo.ssi_PaS_Users u",
                "            JOIN dbo.ssi_PaS_Roles r ON r.role_id=u.role_id",
                "            WHERE u.user_id=@actor_user_id AND u.is_active=1 AND r.can_modify_setup=1",
                "        ) THROW 51401,'An active authorized Setup user is required to remove a piece.',1;",
                "        IF LEN(@note)<10 THROW 51402,'Correction reason must be at least 10 characters.',1;",
                "",
                "        IF NOT EXISTS (",
                "            SELECT 1 FROM dbo.ssi_PaS_Containers WITH (UPDLOCK,HOLDLOCK)",
                "            WHERE container_id=@container_id AND status='OPEN'",
                "        ) THROW 51403,'Only OPEN containers can be corrected.',1;",
                "",
                "        SELECT @piece_id=p.container_piece_id,",
                "               @level_id=p.container_level_id,",
                "               @inspection_id=p.verified_inspection_id",
                "        FROM dbo.ssi_PaS_ContainerPieces p WITH (UPDLOCK,HOLDLOCK)",
                "        JOIN dbo.ssi_PaS_ContainerLevels l WITH (UPDLOCK,HOLDLOCK)",
                "            ON l.container_level_id=p.container_level_id",
                "        WHERE l.container_id=@container_id AND p.product_id=@product_id",
                "          AND l.status='OPEN';",
                "",
                "        IF @piece_id IS NULL THROW 51404,'Piece not found in an OPEN level of this pallet.',1;",
                "",
                "        INSERT dbo.ssi_PaS_PackingAudit",
                "            (event_type,container_id,container_piece_id,container_level_id,",
                "             product_id,inspection_id,actor_user_id,reason)",
                "        VALUES ('REMOVE_PIECE',@container_id,@piece_id,@level_id,",
                "                @product_id,@inspection_id,@actor_user_id,@note);",
                "",
                "        DELETE dbo.ssi_PaS_ContainerPieces WHERE container_piece_id=@piece_id;",
                "        IF @@ROWCOUNT<>1 THROW 51405,'Piece correction failed; no changes were saved.',1;",
                "        COMMIT TRANSACTION;",
                "        SELECT @container_id AS container_id,@product_id AS removed_product_id;",
                "    END TRY",
                "    BEGIN CATCH",
                "        IF @@TRANCOUNT>0 ROLLBACK TRANSACTION;",
                "        THROW;",
                "    END CATCH;",
                "END;"
            })
        End Get
    End Property

End Class
