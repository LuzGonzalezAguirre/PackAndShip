    </Compile>
    <Compile Update="PartialPalletAuthorizationForm.vb">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="PartialPalletAuthorizationForm.Designer.vb">
      <DependentUpon>PartialPalletAuthorizationForm.vb</DependentUpon>
    </Compile>
    <Compile Update="GeneralSettingsForm.vb">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="GeneralSettingsForm.Designer.vb">
      <DependentUpon>GeneralSettingsForm.vb</DependentUpon>
    </Compile>
    <Compile Update="UsersSetupForm.vb">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="UsersSetupForm.Designer.vb">
      <DependentUpon>UsersSetupForm.vb</DependentUpon>
    </Compile>
    <Compile Update="ScanRulesForm.vb">
